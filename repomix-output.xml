  cells.forEach(([c,r],i)=>{const x=4+c*C,y=4+r*C;b+=`<rect class="s ft" x="${x}" y="${y}" width="${C}" height="${C}"/>`;
    b+=sym?`<g transform="matrix(${C} 0 0 ${C} ${x} ${y})">${SYM[lab[i]]}</g>`:`<text class="tx big" x="${x+C/2}" y="${y+C/2}">${NET_LET[lab[i]]}</text>`});

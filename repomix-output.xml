.ksum{display:flex;flex-direction:column;gap:6px;margin-top:6px;color:var(--ink)}
.kcards{display:flex;flex-direction:column;gap:6px;margin-top:4px;max-height:480px;overflow:auto}
.kc{border:1px solid var(--line);border-radius:10px;padding:8px 10px;display:flex;flex-direction:column;gap:4px;color:var(--ink);font-size:14px}
.kc p{margin:0}
.kcb{display:flex;gap:6px;flex-wrap:wrap}
.kconf{display:flex;flex-direction:column;gap:8px;border:1px solid var(--unk);border-radius:10px;padding:10px;background:var(--unk-soft)}
.kconf .kc{background:var(--sheet)}
.cetx{width:100%;box-sizing:border-box;font:15px/1.6 var(--f-body);padding:8px;border-radius:8px;border:1px solid var(--line);background:var(--paper);color:var(--ink)}
.mtop,.mback{display:none}
@media (max-width:760px){
  .mtop{display:flex;align-items:center;gap:10px;position:sticky;top:0;z-index:30;background:var(--rail);border-bottom:1px solid var(--line);
    padding:8px max(12px,env(safe-area-inset-right,0px)) 8px max(12px,env(safe-area-inset-left,0px));padding-top:max(8px,env(safe-area-inset-top,0px))}
  .mbtn{display:flex;align-items:center;gap:6px;font:600 15px var(--f-body);padding:9px 12px;border-radius:10px;border:1px solid var(--line);background:var(--sheet);color:var(--ink);cursor:pointer}
  .mbtn .ic{font-size:20px;line-height:1}
  .mbtn:focus-visible,.mav:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
  .mtitle{flex:1;min-width:0;font:600 16px var(--f-display);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .mav{flex:0 0 auto;font:600 14px var(--f-body);border:none;cursor:pointer;border-radius:999px;padding:0}
  .mav.in{width:36px;height:36px;display:grid;place-items:center;background:var(--accent);color:var(--sheet);font-size:16px}
  .mav.out{padding:8px 12px;background:var(--accent);color:var(--sheet)}
  .app{grid-template-columns:1fr}
  .side{position:fixed;top:0;left:0;bottom:0;z-index:50;width:min(330px,88vw);height:100dvh;box-sizing:border-box;transform:translateX(-105%);
    transition:transform .22s ease;box-shadow:0 0 30px rgba(0,0,0,.35);padding-top:max(16px,env(safe-area-inset-top,0px));padding-bottom:max(24px,env(safe-area-inset-bottom,0px));overflow-y:auto;overscroll-behavior:contain}
  body.menu-open .side{transform:none}
  .mback{position:fixed;inset:0;z-index:45;background:rgba(0,0,0,.45)}
  body.menu-open .mback{display:block}
  body.menu-open{overflow:hidden}
  body.exam-on .mtop{display:none}
  .side .mclose{display:flex}
  .main{padding-top:14px}
}
.mclose{display:none;align-self:flex-end;font:600 14px var(--f-body);padding:7px 12px;border-radius:10px;border:1px solid var(--line);background:var(--sheet);color:var(--ink);cursor:pointer;margin-bottom:-8px}
@media (prefers-reduced-motion:reduce){.side{transition:none}}
@media (max-width:440px){.choices:not(.mc) .ch{font-size:15px;padding:12px 4px}.ask .st{font-size:1.3rem}}
@media (prefers-reduced-motion:reduce){.bar>i{transition:none}.spin{animation-duration:3s}}
/* เลขเวอร์ชัน: เห็นในเมนูซ้าย (คอม) และมุมล่างขวา (มือถือ) */
.ver{margin:12px 0 4px;text-align:center;font-size:12px;color:var(--ink-2);opacity:.7;letter-spacing:.02em}
.vbadge{display:none}
@media (max-width:760px){.vbadge{display:block;position:fixed;right:10px;bottom:calc(10px + env(safe-area-inset-bottom));z-index:25;font-size:11px;color:var(--ink-2);opacity:.55;pointer-events:none}}

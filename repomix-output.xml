    if(doc.pagesParts>0)await syncDeleteParts(doc,'pages',doc.pagesParts);
    if(doc.pagesParts!==0){doc.pagesParts=0;doc.pagesSig='';doc.pagesRemote=false;await saveDoc(doc);await syncPushMeta(doc)}

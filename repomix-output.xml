    if(!d.open)return;const j=+d.dataset.j,q=M.items[j],p=M.picks[j],b=d.querySelector('.body');
    if(!b.dataset.f){b.dataset.f='1';b.innerHTML=fx(`${questionHTML(q)}${choicesHTML(q,p,true)}${explainHTML(q,p)}${askHTML('m'+j,q,p)}`)}

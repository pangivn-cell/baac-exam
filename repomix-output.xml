    const x0=Math.min(...xs)-1,x1=Math.max(...xs)+1,y0=Math.min(...ys)-1,y1=Math.max(...ys)+1,sp=Math.max(x1-x0,y1-y0),S=300/sp,W=(x1-x0)*S+76,H=(y1-y0)*S+40;

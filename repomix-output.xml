      Object.assign(d,{bad:d.pages.map(p=>p.n),ocrDone:[],digDone:0,summ:[],stage:'ocr',err:'',warn:'',reprocess:true,figMeta:[],cardsResetAt:Date.now(),delCards:[],dupSkipped:0,dupOf:''});

/* 3) หมุนรูป/ภาพสะท้อน: รูปต่อจากช่องสี่เหลี่ยมที่ไม่สมมาตร ทั้ง 8 แบบ (หมุน 4 × พลิก 2) ต่างกันหมด */
const shpN=c=>{const mx=Math.min(...c.map(p=>p[0])),my=Math.min(...c.map(p=>p[1]));return c.map(([x,y,m])=>[x-mx,y-my,m])};

  let b=c.map(([x,y,m])=>`<rect class="s ft" x="${4+x*C}" y="${4+y*C}" width="${C}" height="${C}"/>${m?`<circle class="ink" cx="${4+x*C+C/2}" cy="${4+y*C+C/2}" r="5"/>`:''}`).join('');

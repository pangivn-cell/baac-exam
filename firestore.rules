rules_version = '2';
// ระบบซ้อมสอบ: คลังกลาง (kb) ทุกคนอ่านได้ / ส่งเข้าคลัง (subs) ต้องล็อกอิน / ผู้ตรวจอนุมัติ
// ตั้งแอดมินคนแรกโดยแก้ users/{uid}.role เป็น "admin" ในหน้า Firestore ของ Firebase console
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() { return exists(me()) ? get(me()).data.role : 'user'; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isReviewer() { return signedIn() && role() in ['admin', 'reviewer']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isReviewer());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
    // บันทึกโจทย์ที่เคยทำ + ตั้งค่า AI (aiset) ของแต่ละคน (ซิงก์ข้ามเครื่อง) เจ้าของอ่าน/เขียนได้คนเดียว
    match /users/{uid}/qlog/{doc} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // คิว + คลังส่วนตัว (ซิงก์ข้ามเครื่อง): เจ้าของเท่านั้น
    //   docs/{key} = ข้อมูลเอกสาร/สถานะคิว/lease · pages, cards = เนื้อหาแบ่งก้อน · figs = รูปประกอบ
    match /users/{uid}/docs/{doc} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /pages/{part} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /cards/{part} { allow read, write: if signedIn() && request.auth.uid == uid; }
    }
    match /users/{uid}/figs/{fig} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // คลังกลางที่อนุมัติแล้ว: ใครก็อ่านได้ (ไม่ต้องล็อกอิน) เขียนได้เฉพาะผู้ตรวจ
    match /kb/{id} {
      allow read: if true;
      allow write: if isReviewer();
    }
    match /kbfigs/{id} {
      allow read: if true;
      allow write: if isReviewer();
    }

    // ของที่ส่งเข้ามา รอผู้ตรวจอนุมัติ
    match /subs/{id} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isReviewer());
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isReviewer()
        || (signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.status == 'pending' && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isReviewer()
        || (signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'pending');
    }
    match /subfigs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isReviewer() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // อันดับผู้สอบ (all / w2026-43 / m2026-10): ทุกคนอ่านได้ เขียนได้เฉพาะของตัวเอง เพิ่มได้ไม่เกิน 1000 คะแนนต่อครั้ง
    match /rank/{period}/u/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.pts is number && request.resource.data.pts >= 0 && request.resource.data.pts <= 1000;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.pts >= resource.data.pts && request.resource.data.pts <= resource.data.pts + 1000;
    }

    // ตั้งค่าระบบ เช่น โฟลเดอร์ Google Drive ของไฟล์ต้นฉบับ (config/srcdirs): ผู้ที่ล็อกอินอ่านได้ ผู้ตรวจแก้ได้
    match /config/{id} {
      allow read: if signedIn() || id == 'subjects';
      allow write: if isReviewer();
    }

    // คลังโจทย์กลาง: โจทย์ที่ AI สร้างแล้ว ทุกคนใช้ซ้ำได้ (อ่านได้ทุกคน · เพิ่มได้เมื่อล็อกอิน · ผู้ตรวจแก้/ลบได้)
    match /qpool/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.items is list && request.resource.data.items.size() <= 40;
      // ผู้ใช้บันทึกได้เฉพาะช่อง used (ว่าตัวเองทำข้อไหนแล้ว)
      allow update: if isReviewer()
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']));
      allow delete: if isReviewer();
    }

    // อันดับแบบใหม่: ทำชุดผ่าน = 1 คะแนน (pass) เพิ่มได้ครั้งละไม่เกิน 5
    match /rank2/{period}/u/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.pass is number && request.resource.data.pass >= 0 && request.resource.data.pass <= 5;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.pass >= resource.data.pass && request.resource.data.pass <= resource.data.pass + 5;
    }

    // รายงานเฉลยผิด
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open';
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isReviewer());
      allow update, delete: if isReviewer();
    }
  }
}

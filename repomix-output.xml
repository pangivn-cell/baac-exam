  document.getElementById('hclear').onclick=async()=>{if(await modal('<p class="mt">ล้างประวัติสอบทั้งหมด?</p><p class="src">ลบแล้วกู้คืนไม่ได้</p>',[{t:'ยกเลิก'},{t:'ล้างประวัติ',cls:'primary'}])===1){HIST=[];saveHist();renderHist()}};
}

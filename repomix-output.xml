const MIME_BY_EXT={png:'image/png',jpg:'image/jpeg',jpeg:'image/jpeg',gif:'image/gif',webp:'image/webp',bmp:'image/bmp',svg:'image/svg+xml',emf:'image/emf',wmf:'image/wmf',tif:'image/tiff',tiff:'image/tiff'};

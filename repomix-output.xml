/* ล้างรูปเดิมของเอกสาร (ใช้ตอน "ให้ AI อ่านทุกหน้าใหม่") ไม่ให้เครื่องอื่นเห็นรูปที่ถูกลบแล้ว */
async function syncClearFigs(doc){

      <div class="field" id="mcustw" ${MS.min==='custom'?'':'hidden'}><label for="mcust">กำหนดเวลาเอง (นาที)</label><input class="tx" id="mcust" type="number" min="1" max="300" inputmode="numeric" value="${esc(MS.custom)}"></div>

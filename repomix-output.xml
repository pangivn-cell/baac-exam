<file path="css/app.css">
/* Layout: left rail (subjects + settings) beside one exam-sheet column; rail becomes a top strip on phones */
:root{
  --paper:#f3f5f8; --sheet:#ffffff; --rail:#e9edf4; --ink:#1c2538; --ink-2:#56607a; --line:#d9dee8;
  --accent:#2f47b8; --accent-soft:#e6eafb;
  --ok:#1f7a4d; --ok-soft:#e3f3ea; --bad:#b3322b; --bad-soft:#f9e5e3; --unk:#9a6206; --unk-soft:#fbf0dc;
  --mark:#c47a12;
  --cube-t:#e4e9f7; --cube-l:#b9c4e8; --cube-r:#8d9cd3; --paper-c:#fdf6e3;
  --f-display:"Anuphan","Sarabun",system-ui,sans-serif;
  --f-body:"Sarabun",system-ui,sans-serif;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --paper:#11151f; --sheet:#1a2030; --rail:#151a27; --ink:#e7ebf4; --ink-2:#a2abc2; --line:#2e3750;
  --accent:#8fa2ff; --accent-soft:#252f52;
  --ok:#6fd3a0; --ok-soft:#173527; --bad:#ff8f86; --bad-soft:#3a1c1b; --unk:#f0bf63; --unk-soft:#3a2c12;
  --mark:#f0bf63; --cube-t:#5a6aa3; --cube-l:#3c4a7c; --cube-r:#283358; --paper-c:#3b3626; color-scheme:dark}}
:root[data-theme="dark"]{
  --paper:#11151f; --sheet:#1a2030; --rail:#151a27; --ink:#e7ebf4; --ink-2:#a2abc2; --line:#2e3750;
  --accent:#8fa2ff; --accent-soft:#252f52;
  --ok:#6fd3a0; --ok-soft:#173527; --bad:#ff8f86; --bad-soft:#3a1c1b; --unk:#f0bf63; --unk-soft:#3a2c12;
  --mark:#f0bf63; --cube-t:#5a6aa3; --cube-l:#3c4a7c; --cube-r:#283358; --paper-c:#3b3626; color-scheme:dark}
body{background:var(--paper);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.6}
button,select,textarea{font-family:var(--f-body)}
.app{display:grid;grid-template-columns:250px minmax(0,1fr);min-height:100vh}
.side{background:var(--rail);border-right:1px solid var(--line);padding-block:20px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:16px;display:flex;flex-direction:column;gap:18px;position:sticky;top:env(safe-area-inset-top,0px);align-self:start;height:100vh;box-sizing:border-box;overflow-y:auto}
.brand{font-family:var(--f-display);font-weight:600;font-size:1.35rem;margin:0}
.brand small{display:block;font:400 13px var(--f-body);color:var(--ink-2)}
.cap{font-size:12px;letter-spacing:.06em;color:var(--ink-2);margin:0 0 6px}
nav.subjects{display:flex;flex-direction:column;gap:4px}
.subj{display:flex;justify-content:space-between;align-items:center;gap:8px;text-align:left;font:500 15px var(--f-body);padding:9px 10px;border-radius:10px;border:1px solid transparent;background:transparent;color:var(--ink);cursor:pointer}
.subj:hover{background:var(--sheet)}
.subj[aria-current="true"]{background:var(--sheet);border-color:var(--accent);color:var(--accent)}
.lv{font:600 12px var(--f-body);padding:2px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);white-space:nowrap;font-variant-numeric:tabular-nums}
.set{display:flex;flex-direction:column;gap:12px}
.field{display:flex;flex-direction:column;gap:4px}
.field label,.field .fl{font-size:14px;color:var(--ink-2)}
input.tx,select{font-size:15px;box-sizing:border-box;width:100%;padding:7px 8px;border-radius:8px;border:1px solid var(--line);background:var(--sheet);color:var(--ink)}
.seg{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.seg button{font:500 14px var(--f-body);padding:8px 4px;border:none;background:var(--sheet);color:var(--ink);cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--sheet)}
.aiset{border-top:1px solid var(--line);padding-top:12px}
.aiset summary{cursor:pointer;font-weight:600;font-size:15px;display:flex;justify-content:space-between;gap:8px}
.aiset .bd{display:flex;flex-direction:column;gap:10px;padding-top:10px}
.aiset .hint{font-size:13px;color:var(--ink-2);margin:0;line-height:1.5}
.aiset .ok{color:var(--ok)} .aiset .err{color:var(--bad)}
.aiset .btns{display:flex;gap:6px;flex-wrap:wrap}
.klink{font-size:13px;color:var(--accent);text-decoration:none;align-self:flex-start}
.klink:hover{text-decoration:underline}
.howto{border:1px solid var(--line);border-radius:10px;padding:8px 10px;background:var(--sheet)}
.howto summary{cursor:pointer;font-size:14px;font-weight:600}
.howto ol{margin:8px 0 4px;padding-left:20px;display:flex;flex-direction:column;gap:4px;font-size:13px;line-height:1.55}
.howto a{color:var(--accent);overflow-wrap:anywhere}
.pill{font:600 12px var(--f-body);padding:2px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);white-space:nowrap}
.primary{font:600 15px var(--f-body);padding:10px 14px;border-radius:10px;border:none;background:var(--accent);color:var(--sheet);cursor:pointer}
.primary:disabled{opacity:.5;cursor:default}
.ghost{font:500 13px var(--f-body);padding:6px 10px;border-radius:8px;border:1px solid var(--line);background:transparent;color:var(--ink-2);cursor:pointer}
.main{padding-block:24px 56px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));min-width:0}
.col{max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:14px}
.head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap}
.head h1{font-family:var(--f-display);font-weight:600;font-size:1.5rem;margin:0;text-wrap:balance}
.head p{margin:0;color:var(--ink-2);font-size:14px}
.sheet{background:var(--sheet);border:1px solid var(--line);border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:14px;min-width:0}
.meta{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:14px;color:var(--ink-2);font-variant-numeric:tabular-nums}
.bar{height:6px;background:var(--line);border-radius:99px;overflow:hidden}
.bar>i{display:block;height:100%;background:var(--accent);transition:width .3s}
.given{display:grid;grid-template-columns:auto 1fr;column-gap:12px;row-gap:2px;font-size:1.15rem;align-items:baseline;overflow-x:auto}
.given .k{color:var(--ink-2);font-size:15px}
.given .eq{font-weight:500;white-space:nowrap}
.given .note{grid-column:2;color:var(--ink-2);font-size:14px}
.ask{border-top:1px dashed var(--line);padding-top:12px}
.ask .lab{font-size:14px;color:var(--ink-2)}
.ask .st2{font-family:var(--f-display);font-weight:600;font-size:1.15rem}
.ask .st{font-family:var(--f-display);font-weight:600;font-size:1.5rem;white-space:nowrap;overflow-x:auto}
.stem{white-space:pre-wrap;font-size:1.1rem;overflow-wrap:anywhere}
.choices{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.choices.mc{grid-template-columns:1fr}
.ch{font:600 16px var(--f-body);padding:12px 10px;border-radius:10px;border:1.5px solid var(--line);background:var(--sheet);color:var(--ink);cursor:pointer;text-align:center}
.choices.mc .ch{text-align:left;font-weight:500;display:flex;gap:10px;align-items:baseline}
.choices.mc .ch b{color:var(--accent);min-width:1.2em}
.ch:hover:not(:disabled){border-color:var(--accent)}
.ch.sel{border-color:var(--accent);background:var(--accent-soft)}
.ch:disabled{cursor:default}
.ch.right{background:var(--ok-soft);border-color:var(--ok);color:var(--ok)}
.qsvgw{margin:0;display:flex;flex-wrap:wrap;gap:8px 6px;align-items:center;justify-content:center;padding:12px 8px;border:1px solid var(--line);border-radius:10px;background:var(--sheet)}
.qsvg{display:block;max-width:100%;height:auto}
.qsvg .s{stroke:var(--ink);stroke-width:1.5;stroke-linejoin:round;stroke-linecap:round}
.qsvg .ln{fill:none} .qsvg .ft{fill:var(--cube-t)} .qsvg .fl{fill:var(--cube-l)} .qsvg .fr{fill:var(--cube-r)} .qsvg .pp{fill:var(--paper-c)}
.qsvg .ink{fill:var(--ink)} .qsvg .sym{fill:none;stroke:var(--ink);stroke-width:2.4} .qsvg .shade{fill:var(--cube-l)}
.qsvg .acc{stroke:var(--accent);stroke-width:2} .qsvg .accf{fill:var(--accent)} .qsvg .dash{stroke-dasharray:4 3}
.qsvg .gr{fill:none;stroke:var(--ink-2);stroke-width:.6;opacity:.45}
.qsvg .tx{fill:var(--ink);font:600 15px var(--f-body);text-anchor:middle;dominant-baseline:central} .qsvg .tx.big{font-size:20px} .qsvg .tx.sm{font-size:11px;font-weight:500;fill:var(--ink-2)}
.qarrow{color:var(--ink-2);font-size:18px}
.choices.pics{grid-template-columns:1fr 1fr}
.choices.mc.pics .ch{align-items:center;justify-content:flex-start;gap:8px;padding:8px}
.chsvg{flex:1;display:flex;justify-content:center;min-width:0}
.ch.right .chsvg,.ch.wrong .chsvg{background:var(--sheet);border-radius:6px}
.ch.wrong{background:var(--bad-soft);border-color:var(--bad);color:var(--bad);text-decoration:line-through}
:is(.ch,.subj,.seg button,.primary,.ghost,.qk,.send,.stop,select,textarea,summary):focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.verdict{font-family:var(--f-display);font-weight:600;font-size:1.1rem;margin:0}
.verdict.good{color:var(--ok)} .verdict.bad{color:var(--bad)}
.explain{display:flex;flex-direction:column;gap:10px}
.lbl{font-size:13px;color:var(--ink-2);margin:0;letter-spacing:.02em}
.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.chip{border:1px solid var(--line);background:var(--accent-soft);color:var(--ink);border-radius:8px;padding:4px 10px;font-weight:600}
.chip.hl{outline:2px solid var(--mark);outline-offset:2px}
.chip.dim,.op.dim{opacity:.35}
.op{color:var(--ink-2);font-size:18px}
.op.hl{color:var(--mark);font-weight:600}
ol.steps{margin:0;padding-left:22px;display:flex;flex-direction:column;gap:6px}
.src{color:var(--ink-2);font-size:13px}
.navrow{display:flex;justify-content:space-between;align-items:center;gap:8px}
.state{display:flex;flex-direction:column;gap:12px;align-items:center;text-align:center;padding-block:28px}
.state p{margin:0;max-width:44ch}
.spin{width:36px;height:36px;border-radius:50%;border:3px solid var(--line);border-top-color:var(--accent);animation:sp 1s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
.result{display:flex;flex-direction:column;gap:12px;align-items:center;text-align:center}
.sticker{font-size:72px;line-height:1;width:120px;height:120px;display:grid;place-items:center;border-radius:50%;background:var(--accent-soft);border:3px solid var(--sheet);box-shadow:0 0 0 2px var(--line)}
.sticker.good{background:var(--ok-soft)} .sticker.mid{background:var(--unk-soft)} .sticker.bad{background:var(--bad-soft)}
@media (prefers-reduced-motion:no-preference){.sticker{animation:pop .6s cubic-bezier(.2,1.6,.4,1)}}
@keyframes pop{from{transform:scale(.4) rotate(-12deg)}to{transform:none}}
.big{font-family:var(--f-display);font-size:2.6rem;font-weight:600;font-variant-numeric:tabular-nums;margin:0}
.msgt{font-family:var(--f-display);font-weight:600;font-size:1.3rem;margin:0}
.lvchg{font-size:14px;padding:4px 12px;border-radius:999px;background:var(--accent-soft);color:var(--accent)}
.review{width:100%;text-align:left;display:flex;flex-direction:column;gap:8px}
.review details{border:1px solid var(--line);border-radius:10px;padding:8px 12px}
.review summary{cursor:pointer;display:flex;justify-content:space-between;gap:8px}
.review summary span:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

}
function renderRun(el){
  const n=M.items.length,i=M.i,q=M.items[i],pick=M.picks[i];
  el.innerHTML=fx(`<div class="meta"><span>ข้อ ${i+1} จาก ${n}</span><span>${esc(q.subName||'')}</span></div>
    ${questionHTML(q)}
